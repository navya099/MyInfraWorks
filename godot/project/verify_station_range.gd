extends SceneTree
const Model=preload("res://scripts/road_model.gd")
const Table=preload("res://scripts/station_table.gd")
func _initialize():
 var model=Model.new()
 model.demo()
 model.route=PackedVector3Array([Vector3(600,0,1000),Vector3(1600,0,1000)])
 model.pvi_stations=PackedFloat64Array([0,500,1000])
 model.pvi_heights=PackedFloat64Array([100,150,100])
 model.pvi_lengths=PackedFloat64Array([0,200,0])
 model.left_fall=2
 model.right_fall=4
 model.offset=3
 assert(model.rebuild_alignment()=="")
 model.source.OriginX=1000000.0
 model.source.OriginY=2000000.0
 var before=model.edit_state()
 var result=Table.calculate_job(model.snapshot(),100,{"begin":425.25,"end":575.75})
 assert(result.ok and result.rows.size()==3)
 assert(result.rows[0].station==425.25 and result.rows[1].station==500 and result.rows[2].station==575.75)
 assert("range_start" in result.rows[0].events and "range_end" in result.rows[-1].events)
 assert("PVI" in result.rows[1].events and "regular" in result.rows[1].events)
 assert(model.edit_state()==before)
 var file=FileAccess.open("user://station-range-analytic.json",FileAccess.WRITE)
 file.store_string(JSON.stringify(result))
 file.close()
 var full=Table.calculate_job(model.snapshot(),300)
 var explicit=Table.calculate_job(model.snapshot(),300,{"begin":0,"end":1000})
 assert(full.rows==explicit.rows)
 result=Table.calculate_job(model.snapshot(),300,{"begin":350,"end":650})
 assert(result.rows.size()==5)
 assert(result.rows[1].station==400 and "vertical_curve_start" in result.rows[1].events)
 assert(result.rows[3].station==600 and "vertical_curve_end" in result.rows[3].events)
 result=Table.calculate_job(model.snapshot(),100,{"begin":499.9999999,"end":600.0000001})
 assert(result.rows.size()==2 and result.rows[0].station==499.9999999 and result.rows[-1].station==600.0000001)
 for bounds in [{"begin":-1,"end":100},{"begin":0,"end":1001},{"begin":50,"end":40},{"begin":50,"end":50.5},{"begin":NAN,"end":100},{"begin":0,"end":INF}]:
  assert(not Table.calculate_job(model.snapshot(),100,bounds).ok)
 var hole=model.source.duplicate(true)
 var heights=hole.Heights.duplicate()
 heights.fill(NAN)
 hole.Heights=heights
 var snapshot=model.snapshot()
 snapshot.source=hole
 result=Table.calculate_job(snapshot,100,{"begin":425.25,"end":575.75})
 assert(result.missing==3 and result.rows[1].ground==null and result.rows[1].delta==null and result.rows[1].planned==148)
 model.route=PackedVector3Array([Vector3(100,100,900),Vector3(900,100,900),Vector3(900,100,100)])
 model.radii=PackedFloat64Array([0,300,0])
 model.spirals=PackedFloat64Array([0,0,0])
 model.pvi_stations=PackedFloat64Array()
 assert(model.rebuild_alignment()=="")
 result=Table.calculate_job(model.snapshot(),100,{"begin":450,"end":650})
 assert(result.rows.size()==4 and result.rows[1].station==500 and "geometry_boundary" in result.rows[1].events)
 assert(abs(result.rows[2].radius-300)<0.00001)
 model.route=PackedVector3Array([Vector3(0,100,0),Vector3(100000,100,0)])
 model.radii=PackedFloat64Array([0,0])
 model.spirals=PackedFloat64Array([0,0])
 model.pvi_stations=PackedFloat64Array()
 assert(model.rebuild_alignment()=="")
 assert(not Table.calculate_job(model.snapshot(),1).ok)
 result=Table.calculate_job(model.snapshot(),1,{"begin":50000,"end":50100})
 assert(result.ok and result.rows.size()==101 and result.rows[0].station==50000)
 assert(Table.calculate_job(model.snapshot(),1,{"begin":0,"end":19999}).rows.size()==20000)
 assert(not Table.calculate_job(model.snapshot(),1,{"begin":0,"end":20000}).ok)
 assert(Table.calculate_job(model.snapshot(),1,{"begin":50000,"end":50001}).ok)
 print("STATION RANGE FIXTURES "+ProjectSettings.globalize_path("user://"))
 print("PASS STATION RANGE CORE: exact ends/event priority, PVI/BVC/EVC/curve boundaries, actual parabola, full compatibility, NoData, invalid/minimum ranges and subset budgets")
 quit(0)
