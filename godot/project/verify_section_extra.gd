extends SceneTree
const Model=preload("res://scripts/road_model.gd")
const Dxf=preload("res://scripts/section_dxf_geometry.gd")
func save(name,result):
 assert(result.ok,str(result))
 var file=FileAccess.open("user://"+name,FileAccess.WRITE)
 assert(file!=null)
 file.store_string(result.text)
 file.close()
func _initialize():
 var heights=PackedFloat64Array()
 heights.resize(201*201)
 heights.fill(0)
 var terrain={"Nx":201,"Ny":201,"Dx":1.0,"Dy":1.0,"Min":0.0,"Max":0.0,"Heights":heights}
 var model=Model.new()
 model.terrain=terrain
 model.source=terrain
 model.route=PackedVector3Array([Vector3(50,2,100),Vector3(150,2,100)])
 model.left_fall=2
 model.right_fall=4
 assert(model.rebuild_alignment()=="")
 var before=model.edit_state()
 var result=Dxf.calculate_job(model.snapshot(),25,30,1,3,{},"87.75, 12.25, 50, 50, 0, 100")
 assert(result.ok and result.sections.size()==7 and result.samples==427 and result.extra_requested==6)
 assert(result.sections[1].station==12.25 and result.sections[-2].station==87.75)
 assert(model.edit_state()==before)
 save("section-extra-analytic.dxf",result)
 result=Dxf.calculate_job(model.snapshot(),25,30,1,3,{"begin":10,"end":90},"12.25,87.75")
 assert(result.ok and result.sections.size()==7 and result.sections[0].station==10 and result.sections[-1].station==90)
 save("section-extra-range.dxf",result)
 save("section-extra-near.dxf",Dxf.calculate_job(model.snapshot(),25,30,1,3,{},"25.00000001, 0.00000001, 99.99999999"))
 var original=Dxf.calculate_job(model.snapshot(),25,30,1,3)
 var blank=Dxf.calculate_job(model.snapshot(),25,30,1,3,{},"  ")
 assert(original.text==blank.text)
 save("section-extra-empty.dxf",blank)
 for bad in ["bad","1,,2",",1","1,","NaN","INF","1 2"]:assert(not Dxf.parse_extra(bad).ok)
 assert(Dxf.parse_extra("1, 2.5, 3e1").stations.size()==3)
 for bad in ["-1","101"]:assert(not Dxf.calculate_job(model.snapshot(),25,30,1,3,{},bad).ok)
 assert(not Dxf.calculate_job(model.snapshot(),25,30,1,3,{"begin":10,"end":90},"5").ok)
 var many=PackedStringArray()
 for i in range(100):many.append(str(i))
 assert(Dxf.parse_extra(",".join(many)).ok)
 many.append("100")
 assert(not Dxf.parse_extra(",".join(many)).ok)
 model.route=PackedVector3Array([Vector3(50,2,100),Vector3(100050,2,100)])
 model.pvi_stations=PackedFloat64Array()
 assert(model.rebuild_alignment()=="")
 assert(not Dxf.calculate_job(model.snapshot(),1,5,50,3,{"begin":50000,"end":50499},"50000.5").ok)
 assert(not Dxf.calculate_job(model.snapshot(),1,500,1,3,{"begin":50000,"end":50098},"50000.5").ok)
 print("SECTION EXTRA FIXTURES "+ProjectSettings.globalize_path("user://"))
 print("PASS EXTRA SECTION CORE: exact additions, sorted merge/priorities, clipped range, blank compatibility, malformed/finite/count/range checks and combined budgets")
 quit(0)
