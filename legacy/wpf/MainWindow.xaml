<Window x:Class="KRoadPrototype.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="K-ROAD · 개략 노선설계" Width="1400" Height="900" Background="#101922" Foreground="#DFEAF1"><DockPanel Margin="14"><StackPanel DockPanel.Dock="Top"><TextBlock Text="K-ROAD / TERRAIN + ALIGNMENT" FontSize="26" Margin="0,0,0,12"/><WrapPanel><Button Content="DEM 열기" Click="OpenDem" Padding="12,7"/><Button Content="데모" Click="Demo" Padding="12,7"/><Button Content="노선 초기화" Click="Clear" Padding="12,7"/><Button Content="저장" Click="Save" Padding="12,7"/><Button Content="열기" Click="Load" Padding="12,7"/><TextBlock Text="  폭(m) "/><TextBox x:Name="WidthInput" Text="20" Width="50"/><TextBlock Text="  높이 보정(m) "/><TextBox x:Name="OffsetInput" Text="0" Width="50"/><TextBlock Text="  사면 H:V "/><TextBox x:Name="SlopeInput" Text="1.5" Width="50"/><Button Content="적용" Click="Apply" Padding="12,7"/></WrapPanel><TextBlock x:Name="Status" Margin="0,10" TextWrapping="Wrap" Foreground="#7ED9C3"/></StackPanel><TextBlock DockPanel.Dock="Bottom" Text="평면 클릭: 점 추가 | 종단 클릭: 계획고 편집 | 3D 드래그: 회전 / 휠: 확대 | 축소 DEM 기반 개략 미리보기" Margin="0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition/></Grid.RowDefinitions><DockPanel Background="#192632" Margin="4"><TextBlock DockPanel.Dock="Top" Text="평면 / PLAN · 북쪽 ↑" Margin="8"/><Canvas x:Name="Plan" Background="#192632" ClipToBounds="True" MouseLeftButtonDown="PlanClick" SizeChanged="Resize"/></DockPanel><DockPanel Grid.Column="1" Background="#192632" Margin="4"><TextBlock DockPanel.Dock="Top" Text="3D / 계획지형" Margin="8"/><Viewport3D x:Name="Scene" MouseLeftButtonDown="SceneDown" MouseLeftButtonUp="SceneUp" MouseMove="SceneMove" MouseWheel="SceneWheel"/></DockPanel><DockPanel Grid.Row="1" Background="#192632" Margin="4"><TextBlock DockPanel.Dock="Top" Text="종단 / PROFILE · 클릭: 가까운 제어점 