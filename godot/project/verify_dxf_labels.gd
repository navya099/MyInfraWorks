extends SceneTree
const Model=preload("res://scripts/road_model.gd")
const Dxf=preload("res://scripts/dxf_geometry.gd")
const Labels=preload("res://scripts/dxf_station_labels.gd")
func save_fixture(name,result):
 assert(result.ok)
 var file=FileAccess.open("user://"+name,FileAccess.WRITE)
 assert(file!=null)
 file.store_string(result.text)
 file.close()
func _initialize():
 var model=Model.new()
 model.demo()
 model.route=PackedVector3Array([Vector3(100,100,200),Vector3(200,100,200)])
 model.offset=3
 model.left_fall=2
 model.right_fall=4
 assert(model.rebuild_alignment()=="")
 var before=model.edit_state()
 var result=Dxf.calculate_job(model.snapshot(),10,0,40)
 assert(result.ok and result.annotation_count==4 and result.annotation_step==40)
 assert(model.edit_state()==before)
 save_fixture("dxf-labels-east.dxf",result)
 save_fixture("dxf-labels-large.dxf",Dxf.calculate_job(model.snapshot(),10,0,40,10))
 save_fixture("dxf-labels-disabled.dxf",Dxf.calculate_job(model.snapshot(),10,0))
 model.source.OriginX=1000000.0
 model.source.OriginY=2000000.0
 save_fixture("dxf-labels-projected.dxf",Dxf.calculate_job(model.snapshot(),10,1,40))
 for data in [{"name":"west","points":PackedVector3Array([Vector3(200,100,200),Vector3(100,100,200)])},{"name":"north","points":PackedVector3Array([Vector3(100,100,300),Vector3(100,100,100)])},{"name":"south","points":PackedVector3Array([Vector3(100,100,100),Vector3(100,100,300)])}]:
  model.route=data.points
  model.pvi_stations=PackedFloat64Array()
  assert(model.rebuild_alignment()=="")
  save_fixture("dxf-labels-"+data.name+".dxf",Dxf.calculate_job(model.snapshot(),10,0,40))
 model.route=PackedVector3Array([Vector3(100,100,900),Vector3(900,100,900),Vector3(900,100,100)])
 model.radii=PackedFloat64Array([0,300,0])
 model.spirals=PackedFloat64Array([0,0,0])
 model.pvi_stations=PackedFloat64Array()
 assert(model.rebuild_alignment()=="")
 save_fixture("dxf-labels-curve.dxf",Dxf.calculate_job(model.snapshot(),10,0,200,10))
 model.route=PackedVector3Array([Vector3(100,100,200),Vector3(1100,100,200)])
 model.radii=PackedFloat64Array([0,0])
 model.spirals=PackedFloat64Array([0,0])
 model.pvi_stations=PackedFloat64Array([0,500,1000])
 model.pvi_heights=PackedFloat64Array([100,150,100])
 model.pvi_lengths=PackedFloat64Array([0,200,0])
 assert(model.rebuild_alignment()=="")
 save_fixture("dxf-labels-parabola.dxf",Dxf.calculate_job(model.snapshot(),10,0,250))
 model.route=PackedVector3Array([Vector3(0,100,0),Vector3(100.0004,100,0)])
 model.pvi_stations=PackedFloat64Array()
 assert(model.rebuild_alignment()=="")
 result=Dxf.calculate_job(model.snapshot(),10,0,50)
 assert(result.annotation_count==3)
 save_fixture("dxf-labels-near-end.dxf",result)
 for angle in [-PI,-PI/2,-0.2,0,0.2,PI/2,PI]:assert(abs(Labels.readable_rotation(angle))<=90)
 assert(not Dxf.calculate_job(model.snapshot(),10,0,1).ok and not Dxf.calculate_job(model.snapshot(),10,0,NAN).ok)
 model.route=PackedVector3Array([Vector3(0,100,0),Vector3(100000,100,0)])
 model.pvi_stations=PackedFloat64Array()
 assert(model.rebuild_alignment()=="")
 assert(not Dxf.calculate_job(model.snapshot(),25,0,10).ok)
 print("DXF LABEL FIXTURES "+ProjectSettings.globalize_path("user://"))
 print("PASS DXF LABEL CORE: optional labels, design preserved, projected/local output, readable headings, curve/parabola, near-end merge and budgets")
 quit(0)
