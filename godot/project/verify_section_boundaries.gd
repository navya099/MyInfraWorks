extends SceneTree
const Model=preload("res://scripts/road_model.gd")
const Dxf=preload("res://scripts/section_dxf_geometry.gd")
func save(name,result):
 assert(result.ok,str(result))
 var file=FileAccess.open("user://"+name,FileAccess.WRITE)
 assert(file!=null)
 file.store_string(result.text)
 file.close()
func stations(result):
 var values=[]
 for section in result.sections:values.append(section.station)
 return values
func _initialize():
 var heights=PackedFloat64Array()
 heights.resize(201*201)
 heights.fill(0)
 var terrain={"Nx":201,"Ny":201,"Dx":1.0,"Dy":1.0,"Min":0.0,"Max":0.0,"Heights":heights}
 var model=Model.new()
 model.terrain=terrain
 model.source=terrain
 model.route=PackedVector3Array([Vector3(50,2,100),Vector3(150,2,100)])
 model.pvi_stations=PackedFloat64Array([0,50,100])
 model.pvi_heights=PackedFloat64Array([2,4,2])
 model.pvi_lengths=PackedFloat64Array([0,20,0])
 model.left_fall=2
 model.right_fall=4
 assert(model.rebuild_alignment()=="")
 var before=model.edit_state()
 var result=Dxf.calculate_job(model.snapshot(),100,30,1,3,{},"12.25",true)
 assert(result.ok and result.boundary_sections==5 and result.sections.size()==6)
 assert(stations(result)==[0.0,12.25,40.0,50.0,60.0,100.0])
 assert(model.edit_state()==before)
 save("section-boundaries-parabola.dxf",result)
 result=Dxf.calculate_job(model.snapshot(),100,30,1,3,{"begin":42.25,"end":57.75},"",true)
 assert(stations(result)==[42.25,50.0,57.75] and result.boundary_sections==1)
 save("section-boundaries-range.dxf",result)
 result=Dxf.calculate_job(model.snapshot(),10,30,1,3,{},"50.00000001",true)
 assert(result.sections.size()==11 and result.sections[5].station==50)
 save("section-boundaries-merged.dxf",result)
 var off=Dxf.calculate_job(model.snapshot(),100,30,1,3,{},"12.25")
 assert(off.text==Dxf.calculate_job(model.snapshot(),100,30,1,3,{},"12.25",false).text)
 save("section-boundaries-off.dxf",off)
 model.route=PackedVector3Array([Vector3(100,2,900),Vector3(900,2,900),Vector3(900,2,100)])
 model.radii=PackedFloat64Array([0,300,0])
 model.spirals=PackedFloat64Array([0,0,0])
 model.pvi_stations=PackedFloat64Array()
 assert(model.rebuild_alignment()=="")
 result=Dxf.calculate_job(model.snapshot(),10000,30,1,3,{},"",true)
 assert(result.ok and result.sections.size()==5)
 save("section-boundaries-circle.dxf",result)
 model.spirals=PackedFloat64Array([0,50,0])
 assert(model.rebuild_alignment()=="")
 result=Dxf.calculate_job(model.snapshot(),10000,30,1,3,{},"",true)
 assert(result.ok and result.sections.size()==7)
 save("section-boundaries-spiral.dxf",result)
 model.route=PackedVector3Array([Vector3(0,2,100),Vector3(499,2,100)])
 model.radii=PackedFloat64Array([0,0])
 model.spirals=PackedFloat64Array([0,0])
 model.pvi_stations=PackedFloat64Array([0,100.5,499])
 model.pvi_heights=PackedFloat64Array([2,2,2])
 model.pvi_lengths=PackedFloat64Array([0,0,0])
 assert(model.rebuild_alignment()=="")
 assert(not Dxf.calculate_job(model.snapshot(),1,5,50,3,{},"",true).ok)
 model.route[-1].x=98
 model.pvi_stations=PackedFloat64Array([0,50.5,98])
 assert(model.rebuild_alignment()=="")
 assert(not Dxf.calculate_job(model.snapshot(),1,500,1,3,{},"",true).ok)
 print("SECTION BOUNDARY FIXTURES "+ProjectSettings.globalize_path("user://"))
 print("PASS SECTION BOUNDARIES CORE: BVC/PVI/EVC, PI/circle/spiral elements, clipping, priority merge, default-off compatibility, immutable design and final budgets")
 quit(0)
